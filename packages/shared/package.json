{
  "name": "@nullclear/shared",
  "version": "1.2.0",
  "description": "Shared types, ABIs, crypto schemas and chain configurations for NullClear",
  "license": "MIT",
  "homepage": "https://nullclear.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nullclear-Protocol/nullclear.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@nullclear/shared clean\""
  },
  "dependencies": {
    "viem": "^2.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
