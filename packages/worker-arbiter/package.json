{
  "name": "@nullclear/worker-arbiter",
  "version": "1.3.0",
  "private": true,
  "description": "NullClear Arbiter Cloudflare Worker for x402 Deferred Escrow Clearing and Reputation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@nullclear/shared": "workspace:*",
    "hono": "^4.7.0",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.0"
  }
}
