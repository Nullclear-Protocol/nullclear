# ==============================================================================
# NullClear Protocol & Polymarket Guarded Execution — Environment Configuration
# ==============================================================================

# Arbiter / Policy Co-Signer Private Key (0x + 64 hex) — signs EIP-712 PolicyApproval & clearing receipts
# Set via: wrangler secret put ARBITER_PRIVATE_KEY
ARBITER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# Polymarket CLOB V2 & Builder Attribution (Polygon Chain ID 137 / pUSD)
# ------------------------------------------------------------------------------
# 32-byte hex bytes32 builder code embedded inside signed CLOB V2 order struct `builder` field
# Set via: wrangler secret put NULLCLEAR_BUILDER_CODE
NULLCLEAR_BUILDER_CODE=0x4e554c4c434c4541525f56320000000000000000000000000000000000000000

# Builder Keys section (3 variables: API Key, Secret, Passphrase — multi-user Relayer V2 HMAC signing)
# Set via: wrangler secret put POLYMARKET_BUILDER_API_KEY / _SECRET / _PASSPHRASE
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Relayer Keys section (2 variables: API Key, Address — `relayerApiKey({ key, address })`)
# Set via: wrangler secret put POLYMARKET_RELAYER_API_KEY / POLYMARKET_RELAYER_ADDRESS
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_ADDRESS=

# Feature flag for automated POLY_1271 Deposit Wallet session-key copy trading (keep false until small-balance verified)
LIVE_AUTOCOPY_ENABLED=false

# Minimum whale fill notional (USD) for /live Whale Feed & BYO Webhook alerts
POLY_ALERT_MIN_USD=1500

# Admin token guarding POST /api/poly/admin/seed-leaderboard in production
# Set via: wrangler secret put POLY_ADMIN_TOKEN
POLY_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# Existing NullClear Protocol Engine (nullclear.dev)
# ------------------------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
FACILITATOR_URL=https://facilitator.payai.network

# Cloudflare Bindings (configured in wrangler.toml)
# DB (D1 Database: nullclear-db)
# KV / NULLCLEAR_CACHE (KV Namespace)
